Screen {
    layout: horizontal;
}

.column {
    height: 100%;
}

#list {
    width: 16;
    margin: 0 2 0 0;
    border: round $secondary-darken-3;
}

#list:focus {
    border: round $secondary-darken-1;
}

#list Label {
    width: 100%;
    text-align: center;
}

#list ListItem.divider {
    height: 1;
}

#list ListItem.divider Label {
    color: $text-muted;
}

#content {
    width: 1fr;
    height: 100%;
}

#content MarkdownViewer {
    width: 100%;
    height: 1fr;
}

#debug-log {
    height: 12;
    border-top: solid $secondary-darken-3;
}
